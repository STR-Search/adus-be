APP_ENV=development
DATABASE_URL=postgresql://user:password@localhost:5432/enigma
ZILLOW_API_BASE=https://zillow-data-enrichment.onrender.com/
ZILLOW_API_KEY=
CLERK_ISSUER=https://intent-snapper-24.clerk.accounts.dev
CLERK_JWKS_URL=https://intent-snapper-24.clerk.accounts.dev/.well-known/jwks.json
SENTRY_ENABLED=false
SENTRY_DSN=

# n8n automation webhooks (fired on selected deal-status transitions)
#
# Two URLs, same uuid, different path:
#   /webhook/<uuid>       production — ALWAYS LIVE. Every event runs the real
#                         workflow and its downstream actions.
#   /webhook-test/<uuid>  test — only accepts a request while the workflow is in
#                         "Listen for test event" mode in the n8n editor;
#                         returns 404 otherwise.
#
# Left disabled here on purpose: enabling either webhook locally may trigger its
# real automation. Each workflow has its own uuid and independent switch.
N8N_WEBHOOK_PRESENT_TO_CLIENTS_ENABLED=false
N8N_WEBHOOK_PRESENT_TO_CLIENTS_URL=https://[DOMAIN].com/webhook/xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxx
N8N_WEBHOOK_ANALYST_COMPLETED_ENABLED=false
N8N_WEBHOOK_ANALYST_COMPLETED_URL=https://[DOMAIN].com/webhook/yyyyyyyy-yyyy-yyyy-yyyy-yyyyyyy
N8N_WEBHOOK_TIMEOUT_SECONDS=10
